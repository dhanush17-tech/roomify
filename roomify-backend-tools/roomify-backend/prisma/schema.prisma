// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid())
  displayName          String   @map("display_name")
  profileImageUrl      String?  @map("profile_image_url")
  bio                  String?
  email                String   @unique
  language             String   @default("English")
  receiveNotifications Boolean  @default(true) @map("receive_notifications")
  passwordHash         String   @map("password_hash")
  university           String?
  age                  Int?
  gender               String?
  location             String?
  createdAt            DateTime @default(now()) @map("created_at")
  latitude             Float?
  longitude            Float?
  status               String?
  fcmToken             String?
  isAdmin              Boolean  @default(false)
  isProfessional       Boolean  @default(false)

  preferences      UserPreference[]
  socialLinks      UserSocialLink[]
  chatParticipants ChatParticipant[]
  messages         ChatMessage[]

  swipesGiven    RoommateSwipe[] @relation("swiperUser")
  swipesReceived RoommateSwipe[] @relation("swipedUser")
  matches1       RoommateMatch[] @relation("user1Matches")
  matches2       RoommateMatch[] @relation("user2Matches")

  // Relations
  listings       Listing[]
  comments       Comment[]
  favorites      Favorite[]
  passwordResets PasswordReset[]
  activeTokens   ActiveToken[]
  UnreadMessage  UnreadMessage[]
  reports        Report[]

  // Add this relation
  documentRequests DocumentRequest[] @relation("documentRecipient")
  PropertyLead     PropertyLead[]
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])
}

model Listing {
  id          Int      @id @default(autoincrement())
  type        String // "Property" or "Marketplace"
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  userId      String   @map("user_id")
  location    String
  price       Float
  category    String?
  latitude    Float?
  longitude   Float?
  isFavorite  Boolean  @default(false)
  reported    Boolean  @default(false)

  // Relations
  user         User             @relation(fields: [userId], references: [id])
  property     Property?
  marketplace  MarketplaceItem?
  favorites    Favorite[]
  reports      Report[]
  PropertyLead PropertyLead[]
}

model Property {
  listingId           Int     @id @map("listing_id")
  numberOfBedrooms    Int     @map("number_of_bedrooms")
  numberOfBathrooms   Int     @map("number_of_bathrooms")
  maxOccupancy        Int     @map("max_occupancy")
  isLookingForRoomate Boolean @default(false)
  rating              Float   @default(0.0)
  moveInDate          String? @map("move_in_date")
  moveOutDate         String? @map("move_out_date")
  isRoomifyChoice     Boolean @default(false)

  // Location details
  walkScore                 Int?      @default(0) @map("walk_score")
  transitDetails            String?   @default("[]") @map("transit_details")
  lastLocationDetailsUpdate DateTime? @default(now()) @map("last_location_details_update")
  transitScore              Int?      @default(0) @map("transit_score")
  // Relations
  listing    Listing            @relation(fields: [listingId], references: [id])
  amenities  PropertyAmenity[]
  tags       PropertyTag[]
  images     PropertyImage[]
  comments   Comment[]
  categories PropertyCategory[]
  favorites  Favorite[]
}

model PropertyAmenity {
  propertyId Int    @map("property_id")
  amenity    String

  property Property @relation(fields: [propertyId], references: [listingId])

  @@id([propertyId, amenity])
}

model PropertyTag {
  propertyId Int    @map("property_id")
  tag        String

  property Property @relation(fields: [propertyId], references: [listingId])

  @@id([propertyId, tag])
}

model PropertyImage {
  propertyId Int    @map("property_id")
  imageUrl   String @map("image_url")

  property Property @relation(fields: [propertyId], references: [listingId])

  @@id([propertyId, imageUrl])
}

model PropertyCategory {
  propertyId Int    @map("property_id")
  category   String

  property Property @relation(fields: [propertyId], references: [listingId])

  @@id([propertyId, category])
}

model MarketplaceItem {
  listingId Int @id @default(autoincrement())

  // Relations
  listing    Listing               @relation(fields: [listingId], references: [id])
  images     MarketplaceImage[]
  favorites  Favorite[]
  categories MarketplaceCategory[] // Add this relation

  @@map("marketplace_items")
}

// Add new MarketplaceCategory model
model MarketplaceCategory {
  itemId   Int    @map("item_id")
  category String

  // Relations
  item MarketplaceItem @relation(fields: [itemId], references: [listingId])

  @@id([itemId, category])
  @@map("marketplace_categories")
}

model MarketplaceImage {
  itemId   Int    @map("item_id")
  imageUrl String @map("image_url")

  item MarketplaceItem @relation(fields: [itemId], references: [listingId])

  @@id([itemId, imageUrl])
}

model Comment {
  id         Int      @id @default(autoincrement())
  propertyId Int      @map("property_id")
  userId     String   @map("user_id")
  comment    String
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [listingId])
  user     User     @relation(fields: [userId], references: [id])
}

model Favorite {
  userId                   String @map("user_id")
  listingId                Int    @map("listing_id")
  marketplaceItemListingId Int?   @map("marketplace_item_listing_id")
  propertyId               Int?   @map("property_id") // New field for property relation

  // Relations
  user            User             @relation(fields: [userId], references: [id])
  listing         Listing          @relation(fields: [listingId], references: [id])
  marketplaceItem MarketplaceItem? @relation(fields: [marketplaceItemListingId], references: [listingId]) // Make this relation optional
  property        Property?        @relation(fields: [propertyId], references: [listingId]) // New relation for Property

  @@id([userId, listingId])
}

model ActiveToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
}

model RoommateSwipe {
  id        String   @id @default(cuid())
  swiperId  String
  swipedId  String
  direction String
  createdAt DateTime @default(now())
  swiper    User     @relation("swiperUser", fields: [swiperId], references: [id])
  swiped    User     @relation("swipedUser", fields: [swipedId], references: [id])

  @@unique([swiperId, swipedId])
}

model RoommateMatch {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  matchedAt DateTime @default(now())
  user1     User     @relation("user1Matches", fields: [user1Id], references: [id])
  user2     User     @relation("user2Matches", fields: [user2Id], references: [id])

  @@unique([user1Id, user2Id])
}

model UserPreference {
  userId     String @map("user_id")
  preference String
  user       User   @relation(fields: [userId], references: [id])

  @@id([userId, preference])
}

model UserSocialLink {
  userId   String @map("user_id")
  platform String
  username String
  user     User   @relation(fields: [userId], references: [id])

  @@id([userId, platform])
}

model ChatRoom {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants   ChatParticipant[]
  messages       ChatMessage[]
  unreadMessages UnreadMessage[] // Add this relation
}

model ChatParticipant {
  userId String
  roomId String
  user   User     @relation(fields: [userId], references: [id])
  room   ChatRoom @relation(fields: [roomId], references: [id])

  @@id([userId, roomId])
}

model UnreadMessage {
  id          String      @id @default(cuid())
  roomId      String
  messageId   String
  recipientId String
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  room        ChatRoom    @relation(fields: [roomId], references: [id])
  message     ChatMessage @relation(fields: [messageId], references: [id])
  recipient   User        @relation(fields: [recipientId], references: [id])

  @@index([roomId])
  @@index([messageId])
  @@index([recipientId])
}

model DocumentRequest {
  id                 String      @id @default(cuid())
  messageId          String      @unique
  message            ChatMessage @relation(fields: [messageId], references: [id])
  requestedDocuments String // Store as JSON string of DocumentType
  status             String      @default("PENDING") // PENDING, FULFILLED
  recipientId        String // Reference to the recipient user
  createdAt          DateTime    @default(now())
  customDocumentName String? // Optional custom document name

  recipient User @relation("documentRecipient", fields: [recipientId], references: [id])
}

model DocumentSubmission {
  id        String      @id @default(cuid())
  messageId String      @unique
  message   ChatMessage @relation(fields: [messageId], references: [id])
  requestId String // Reference to the original request
  documents String // JSON string of document URLs
  createdAt DateTime    @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  type      String   @default("TEXT")
  content   String
  createdAt DateTime @default(now())
  roomId    String
  senderId  String
  isDeleted Boolean  @default(false)

  documentRequest    DocumentRequest?
  documentSubmission DocumentSubmission?

  room          ChatRoom        @relation(fields: [roomId], references: [id])
  sender        User            @relation(fields: [senderId], references: [id])
  UnreadMessage UnreadMessage[]
}

model Report {
  id        Int      @id @default(autoincrement())
  listingId Int      @map("listing_id")
  userId    String   @map("user_id")
  reason    String
  details   String?
  status    String   @default("pending") // pending, green, listing_removed
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  listing Listing @relation(fields: [listingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("reports")
}

model PropertyLead {
  id         Int      @id @default(autoincrement())
  userId     String   @map("userId")
  propertyId Int      @map("propertyId")
  viewCount  Int      @default(1)
  lastViewed DateTime @default(now()) @map("lastViewed")

  // Relations
  user     User    @relation(fields: [userId], references: [id])
  property Listing @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId])
}
